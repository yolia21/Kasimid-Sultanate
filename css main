/* css/styles.css */

/* --- VARIABLES & RESET --- */
:root {
    --primary-green: #0b3d26; /* Deep Emerald */
    --secondary-green: #145e3b;
    --royal-gold: #d4af37;
    --light-cream: #f9f7f2;
    --text-dark: #2c2c2c;
    --white: #ffffff;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-color: var(--light-cream);
    color: var(--text-dark);
    line-height: 1.6;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
}

h1, h2, h3 {
    font-family: 'Georgia', serif;
    color: var(--primary-green);
}

a {
    text-decoration: none;
    color: inherit;
    transition: 0.3s;
}

/* --- HEADER & NAV --- */
header {
    background-color: var(--primary-green);
    color: var(--white);
    border-bottom: 4px solid var(--royal-gold);
    position: sticky;
    top: 0;
    z-index: 1000;
    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
}

.top-bar {
    background-color: #052617;
    text-align: center;
    padding: 5px 0;
    font-size: 0.85rem;
    color: var(--royal-gold);
    font-style: italic;
}

.nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 5%;
    max-width: 1200px;
    margin: 0 auto;
}

.logo {
    display: flex;
    align-items: center;
    gap: 15px;
}

.logo img {
    height: 50px;
    border: 2px solid var(--royal-gold);
    border-radius: 50%;
}

.logo-text h1 {
    color: var(--white);
    font-size: 1.5rem;
    margin-bottom: -5px;
}

.logo-text span {
    font-size: 0.8rem;
    color: var(--royal-gold);
    text-transform: uppercase;
    letter-spacing: 2px;
}

nav ul {
    display: flex;
    list-style: none;
    gap: 25px;
}

nav a:hover, nav a.active {
    color: var(--royal-gold);
}

.btn-gold {
    background-color: var(--royal-gold);
    color: var(--primary-green);
    padding: 8px 16px;
    border-radius: 4px;
    font-weight: bold;
}

.btn-gold:hover {
    background-color: #b59328;
}

/* --- HERO SECTION (Home Page) --- */
.hero {
    /* Note: We use ../assets because the CSS file is inside the 'css' folder */
    background: linear-gradient(rgba(11, 61, 38, 0.8), rgba(11, 61, 38, 0.8)), url('../assets/hero.jpg'); 
    background-size: cover;
    background-position: center;
    height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: var(--white);
    padding: 0 20px;
}

/* Fallback if user doesn't have an image yet */
.hero.no-img {
    background: linear-gradient(rgba(11, 61, 38, 1), rgba(11, 61, 38, 0.8));
}

.hero-content h2 {
    font-size: 3rem;
    color: var(--royal-gold);
    margin-bottom: 20px;
    text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
}

.hero-content p {
    font-size: 1.2rem;
    max-width: 700px;
    margin: 0 auto 30px;
}

.arabic-motto {
    font-family: 'Arial', sans-serif;
    font-size: 1.5rem;
    margin-bottom: 10px;
    color: var(--white);
}

/* --- GENERAL PAGE CONTENT --- */
.container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 60px 20px;
    flex: 1; /* Pushes footer down */
}

.section-title {
    text-align: center;
    margin-bottom: 50px;
}

.section-title h2 {
    font-size: 2.2rem;
    display: inline-block;
    border-bottom: 3px solid var(--royal-gold);
    padding-bottom: 10px;
}

/* --- CARDS & GRID --- */
.gov-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
}

.card {
    background: var(--white);
    border-top: 5px solid var(--royal-gold);
    box-shadow: 0 5px 15px rgba(0,0,0,0.05);
    padding: 30px;
    text-align: center;
    transition: transform 0.3s;
}

.card:hover {
    transform: translateY(-5px);
    cursor: pointer;
}

.card i {
    font-size: 2.5rem;
    color: var(--primary-green);
    margin-bottom: 20px;
}

/* --- FOOTER --- */
footer {
    background-color: #052617;
    color: #aaa;
    padding: 50px 20px 20px;
    font-size: 0.9rem;
    margin-top: auto;
}

.footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 40px;
    max-width: 1100px;
    margin: 0 auto 40px;
}

.footer-col h4 {
    color: var(--white);
    margin-bottom: 20px;
    border-left: 3px solid var(--royal-gold);
    padding-left: 10px;
}

.footer-col ul {
    list-style: none;
}

.footer-col ul li {
    margin-bottom: 10px;
}

.copyright {
    text-align: center;
    border-top: 1px solid #333;
    padding-top: 20px;
}

/* --- MOBILE RESPONSIVENESS --- */
@media (max-width: 768px) {
    .nav-container {
        flex-direction: column;
        gap: 20px;
    }
    nav ul {
        flex-wrap: wrap;
        justify-content: center;
    }
}
